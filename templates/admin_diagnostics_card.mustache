{{!
    @template block_playerhud/admin_diagnostics_card

    One figure card of the administrator's diagnostics page.

    @package    block_playerhud
    @copyright  2026 Jean Lúcio
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "value": "3",
        "label": "AI requests",
        "subtitle": "Gemini 2 · Groq 1"
    }
}}
<div class="col-6 col-md-4 col-lg-3 mb-3">
    <div class="card h-100">
        <div class="card-body">
            <div class="h3 mb-1">{{value}}</div>
            <div>{{label}}</div>
            {{#subtitle}}<div class="small mt-1">{{subtitle}}</div>{{/subtitle}}
        </div>
    </div>
</div>
