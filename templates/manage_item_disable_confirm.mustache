{{!
    @template block_playerhud/manage_item_disable_confirm

    Confirmation screen shown before disabling an item that quests or trades depend on.

    Context variables required for this template:
    * heading - Pre-formatted, safe heading text (the item name).
    * has_quest_requirement - Whether any quest requires the item.
    * quest_requirement_warning - Impact message for those quests.
    * quest_requirement_list - Array of those quests, each with a name.
    * has_quest_reward - Whether any quest gives the item as a reward.
    * quest_reward_warning - Impact message for those quests.
    * quest_reward_list - Array of those quests, each with a name.
    * has_trades - Whether any trade uses the item.
    * trades_warning - Impact message for those trades.
    * trades_list - Array of those trades, each with a name.
    * form_action - URL the confirmation form posts to.
    * sesskey - Session key.
    * action - Form action value (toggle).
    * item_id - The item ID.
    * sort - Current sort column carried through the form.
    * dir - Current sort direction carried through the form.
    * cancel_url - URL of the cancel button.
    * str_cancel - Cancel button label.
    * confirm_label - Submit button label.

    Example context (json):
    {
        "heading": "Bronze Key",
        "has_quest_requirement": true,
        "quest_requirement_warning": "These quests require this item. While it is disabled they are hidden from students.",
        "quest_requirement_list": [{"name": "Collect 3 keys"}],
        "has_quest_reward": true,
        "quest_reward_warning": "These quests give this item as a reward. While it is disabled they are hidden from students.",
        "quest_reward_list": [{"name": "Finish the maze"}],
        "has_trades": true,
        "trades_warning": "These trades use this item. While it is disabled they are hidden from the shop.",
        "trades_list": [{"name": "Keys for Scroll"}],
        "form_action": "https://example.com/manage.php",
        "sesskey": "abc123",
        "action": "toggle",
        "item_id": 5,
        "sort": "id",
        "dir": "DESC",
        "cancel_url": "https://example.com/manage.php?tab=items",
        "str_cancel": "Cancel",
        "confirm_label": "Disable item"
    }
}}
<div class="block-playerhud-disable-confirm">
    <h3 class="h3">{{{heading}}}</h3>
    {{#has_quest_requirement}}
        <div class="alert alert-warning" role="alert">{{quest_requirement_warning}}</div>
        <ul class="mb-3">
            {{#quest_requirement_list}}
                <li>{{name}}</li>
            {{/quest_requirement_list}}
        </ul>
    {{/has_quest_requirement}}
    {{#has_quest_reward}}
        <div class="alert alert-warning" role="alert">{{quest_reward_warning}}</div>
        <ul class="mb-3">
            {{#quest_reward_list}}
                <li>{{name}}</li>
            {{/quest_reward_list}}
        </ul>
    {{/has_quest_reward}}
    {{#has_trades}}
        <div class="alert alert-warning" role="alert">{{trades_warning}}</div>
        <ul class="mb-3">
            {{#trades_list}}
                <li>{{name}}</li>
            {{/trades_list}}
        </ul>
    {{/has_trades}}
    <form method="post" action="{{form_action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="{{action}}">
        <input type="hidden" name="confirmed" value="1">
        <input type="hidden" name="tab" value="items">
        <input type="hidden" name="sort" value="{{sort}}">
        <input type="hidden" name="dir" value="{{dir}}">
        <input type="hidden" name="itemid" value="{{item_id}}">
        <a href="{{cancel_url}}" class="btn btn-secondary me-2">{{str_cancel}}</a>
        <button type="submit" class="btn btn-warning">{{confirm_label}}</button>
    </form>
</div>
